<Window x:Class="Talisman.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Talisman"
        mc:Ignorable="d"
        Topmost="True"
        Title="Talisman Settings" Height="500" Width="537.321" WindowStyle="ToolWindow">
    <Grid>
        <TabControl Margin="5,20,5,5" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Active Timers" >
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Width="80" HorizontalContentAlignment="Right" Content="Quick Timer:" />
                        <TextBox x:Name="TimerNameBox" MinWidth="150" MaxWidth="150" Text="{Binding QuickTimerName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Focusable="True" TabIndex="0" />
                        <Button Width="20" Content="T" Tag=".01" Click="QuickTimerClick" />
                        <Button Width="20" Content="1" Tag="1" Click="QuickTimerClick" />
                        <Button Width="20" Content="5" Tag="5" Click="QuickTimerClick" />
                        <Button Width="20" Content="10" Tag="10" Click="QuickTimerClick" />
                        <Button Width="20" Content="15" Tag="15" Click="QuickTimerClick" />
                        <Button Width="20" Content="30" Tag="30" Click="QuickTimerClick" />
                        <Button Width="20" Content="C" Tag="Custom" Click="QuickTimerClick" Margin="10,0,0,0" />
                        <TextBox VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Width="30" Text="{Binding CustomQuickTime}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Label Width="80" HorizontalContentAlignment="Right" Content="Time:" />
                        <Border BorderBrush="DarkGray" BorderThickness="2" Height="25" Width="350" >
                            <Canvas x:Name ="TimeClicker" Background="LightGreen" MouseUp="TimeClickerMouseUp" MouseMove="TimeClickerMouseMove" MouseLeave="TimeClickerMouseLeave" >
                            </Canvas>
                        </Border>
                        <Label x:Name="TimeClickerLabel"  Margin="10,0,0,0" />
                    </StackPanel>


                    <Label Content="Active Timers" />
                    <ScrollViewer>
                        <ListView ItemsSource="{Binding ActiveTimers}" MaxHeight="200" Padding="0" >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <local:TimerDetailsWidget HorizontalAlignment="Stretch" Margin="-2" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                    
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Recent Timers" VerticalAlignment="Center" />
                        <Button Content="Clear Recent Timers" Click="ClearRecentTimersClick"
                                Margin="10,0,0,0" Padding="8,1" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer>
                        <ListView ItemsSource="{Binding RecentTimers}" MaxHeight="200" Padding="0" >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <local:RecentTimerWidget HorizontalAlignment="Stretch" Margin="-2" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>


                </StackPanel>

            </TabItem>
            <TabItem Header="Calendar" >
                <Grid>
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Button Content="Add Outlook Calendar" Click="AddOutlookCalendarClick" />
                            <Button Visibility="Collapsed" Content="Add Internet Calendar" Click="AddInternetCalendarClick" Margin="20,0,0,0" />
                        </StackPanel>
                        <Label Content="Active Calendars" />
                        <ScrollViewer Margin="0,0,0,10">
                            <ListView ItemsSource="{Binding Calendars}" MaxHeight="200" >
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <local:CalenderItemWidget />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

            </TabItem>
            <TabItem Header="Hotkeys" >
                <Grid Margin="5" >
                    <StackPanel >
                        <StackPanel Orientation="Horizontal" >
                            <Label Content="Press a hotkey combination:" />
                            <TextBox Text="{Binding OpenHotKey.TextView,Mode=OneWay}" Width="150" Background="LightBlue" PreviewKeyDown="PreviewHotKeyEvent" />
                            <ComboBox ItemsSource="{Binding HotKeyOptions}" SelectedValue="{Binding SelectedHotKeyOption}" DisplayMemberPath="Name" Width="150"/>

                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Argument:" Margin="160,0,0,0" />
                            <TextBox Text="{Binding HotKeyOptionValue,Mode=TwoWay}" Width="250" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" >
                            <Button Content="Assign" Click="AssignHotKey" Margin="20,0,0,0"/>
                            <Button Content="Clear" Click="ClearHotKey"  Margin="10,0,0,0"/>
                            <Label x:Name="AssignmentError" Foreground="Red" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Label Content="Current HotKey Assignments:" Margin="0,20,0,0" />
                        <ListBox ItemsSource="{Binding HotKeyAssignments}" >
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="{Binding}" />
                                        <Label Content="{Binding OptionName}" />
                                        <Label Content="{Binding OptionValue}" />
                                        <Button Content="ý" FontFamily="Wingdings" FontSize="16" Click="DeleteHotKeyClick" Tag="{Binding Id}" Padding="0" Height="18" VerticalAlignment="Top" Foreground="DarkRed" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Pomodoro">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <Label Content="Short &amp; easy tasks (one per line)" />
                            <TextBox Text="{Binding Pomodoro.ShortTasks, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" />
                            <Label Content="Joyful tasks" />
                            <TextBox Text="{Binding Pomodoro.JoyTasks, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" />
                            <Label Content="Administrative tasks" />
                            <TextBox Text="{Binding Pomodoro.AdminTasks, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="95" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <Label Content="Default short tasks (added on top in Phase I)" />
                            <TextBox Text="{Binding Pomodoro.DefaultShortTasks, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
                            <Label Content="Default admin tasks (added on top in Extra phase)" />
                            <TextBox Text="{Binding Pomodoro.DefaultAdminTasks, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Label Width="150" Content="Time per task (min)" />
                                    <TextBox Width="50" Text="{Binding Pomodoro.TimePerTaskMinutes}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Label Width="150" Content="Min short time (min)" />
                                    <TextBox Width="50" Text="{Binding Pomodoro.MinShortMinutes}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Label Width="150" Content="Min tasks" />
                                    <TextBox Width="50" Text="{Binding Pomodoro.MinTasks}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Label Width="150" Content="Max short time (min)" />
                                    <TextBox Width="50" Text="{Binding Pomodoro.MaxShortMinutes}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Label Width="150" Content="Joy time (min)" />
                                    <TextBox Width="50" Text="{Binding Pomodoro.JoyMinutes}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Label Width="150" Content="Admin time (min)" />
                                    <TextBox Width="50" Text="{Binding Pomodoro.AdminMinutes}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Start Pomodoro Day" Click="StartPomodoroClick" Margin="0,12,0,0" Height="30" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Mail Rules">
                <Grid Margin="6" DataContext="{Binding MailRules}">
                    <Grid.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVis" />
                        <Style x:Key="ValueBox" TargetType="TextBox">
                            <Setter Property="Padding" Value="2,0" />
                            <Setter Property="MinWidth" Value="180" />
                            <Setter Property="Margin" Value="0,1" />
                            <Style.Triggers>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#FF555555" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Label Content="Filter:" VerticalAlignment="Center" />
                        <TextBox Width="180" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Refresh" Click="RefreshMailRulesClick" Margin="8,2,0,2" Padding="8,1" />
                        <Button Content="Find shared text" Click="FindSharedTextClick" Margin="6,2,0,2" Padding="8,1" />
                        <Button Content="Save" Click="SaveMailRulesClick" IsEnabled="{Binding CanSave}"
                                Margin="12,2,0,2" Padding="10,1" FontWeight="Bold" />
                        <Button Content="Export…" Click="ExportMailRulesClick" Margin="6,2,0,2" Padding="8,1" />
                        <Button Content="Import…" Click="ImportMailRulesClick" Margin="6,2,0,2" Padding="8,1" />
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="2,5">
                        <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Height="6" Margin="0,3,0,0" Minimum="0"
                                     Maximum="{Binding LoadTotal, Mode=OneWay}" Value="{Binding LoadValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsConnecting}"
                                     Visibility="{Binding ProgressVisibility}" />
                    </StackPanel>
                    <TreeView Grid.Row="2" ItemsSource="{Binding Nodes}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Visibility" Value="{Binding Visibility}" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:MailRuleNode}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:RuleConditionNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    <Button Content="+" Click="AddConditionValueClick" Width="18" Height="16"
                                            Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Add a value"
                                            Visibility="{Binding Editable, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type local:RuleValueNode}">
                                <TextBox Style="{StaticResource ValueBox}"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding ReadOnly}" />
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <StackPanel Grid.Row="3" Margin="0,5,0,0" Visibility="{Binding DuplicateReportVisibility}">
                        <TextBlock Text="{Binding DuplicateReport}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SharedResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:SharedText}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Button Content="⌕" Click="FilterBySharedTextClick" Width="20" Height="18"
                                                    Padding="0" VerticalAlignment="Center" ToolTip="Filter the tree by this term" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Text, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  →  " Foreground="#FF999999" />
                                                <Run Text="{Binding RuleNamesText, Mode=OneWay}" Foreground="#FF555555" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="About Talisman">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228*"/>
                        <ColumnDefinition Width="275*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0" Width="206">
                        <CheckBox IsChecked="{Binding CheckForNewVersion}" Height="20" Content="Check for newer versions at startup"
                                  VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Grid.Column="1" Grid.Row="0" Width="150">
                        <Label Content="Version: " />
                        <Label Content="{Binding VersionText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1" Width="206">
                        <CheckBox   IsEnabled="false"
                                IsChecked="{Binding RunAtStartup}" Height="20" Content="Run at startup"
                                  VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Grid.Row="1" Width="260">
                        <CheckBox IsChecked="{Binding AutoRestartOnCrash}" Height="20" Content="Restart automatically after a crash"
                                  VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,3,0,0">
                        <Label Content="Email crash reports to:" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CrashReportEmail, UpdateSourceTrigger=PropertyChanged}" Width="260"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Leave blank to disable. After a crash, Talisman offers to email this address a copy of the diagnostic log." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" Margin="0,3,0,0">
                        <Label Content="Default text (SMS) to:" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SmsDefaultNumber, UpdateSourceTrigger=PropertyChanged}" Width="160"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Default US mobile number used by the sendsms MCP tool (via Phone Link) when 'to' is omitted." />
                    </StackPanel>

                    <WebBrowser x:Name="HelpText" Margin="0,0,0,1" Grid.ColumnSpan="2"  Grid.Row="4"  />
                </Grid>
            </TabItem>
        </TabControl>
        <Button Content="Quit!" Click="ExitAppClicked" Height="20" Width="42"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,6,0" />
    </Grid>
</Window>
