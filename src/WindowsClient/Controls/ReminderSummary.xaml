<UserControl x:Class="Talisman.ReminderSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Talisman"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TimeText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding DecoratedDescription}" TextWrapping="Wrap" FontWeight="Bold" Padding="0" Margin="5,0,0,0" />
            <ItemsControl Visibility="{Binding LinkVisibility}"
                          ItemsSource="{Binding Links}"
                          Background="Transparent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Padding="0" Margin="5,0,0,0" TextWrapping="Wrap">
                            <Hyperlink NavigateUri="{Binding Uri}"  RequestNavigate="Hyperlink_RequestNavigate" Click="Hyperlink_Click" >
                                <Run Text="{Binding Text, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

    </Grid>
</UserControl>
